# ===== 3x-ui 主控端连接配置 =====
# 3x-ui 面板地址（支持带 webBasePath，例如 http://127.0.0.1:2053/mybasepath）
XUI_PANEL_URL=http://127.0.0.1:2053
# 鉴权方式二选一：优先使用 XUI_API_TOKEN；留空则使用账号密码登录获取 Session Cookie
XUI_API_TOKEN=
XUI_USERNAME=admin
XUI_PASSWORD=your_password
# 面板使用自签 HTTPS 证书时设为 true
XUI_INSECURE_TLS=false

# 3x-ui 订阅拉取源地址（推荐在 3x-ui 把订阅监听 subListen 设为 127.0.0.1，对外不可达）
XUI_SUB_URL=http://127.0.0.1:2096/sub
# 可选：如在 3x-ui 中修改了 Clash / JSON 独立路径，可显式指定；留空则使用 XUI_SUB_URL 配合 User-Agent 自动获取
XUI_SUB_CLASH_URL=
XUI_SUB_JSON_URL=
# 可选：当 3x-ui 入站未填写监听/外部域名且通过 127.0.0.1 拉取时，显式传入公网 IP 或域名作为 Host 头，避免节点地址生成为 localhost
XUI_SUB_HOST=

# ===== Cloudflare KV 推送配置（可配置对外订阅域名） =====
# 最终下发/展示给用户的 Cloudflare 域名（可随时切换，修改后下次同步会自动更新到 KV）
CF_PUBLIC_DOMAIN=https://sub.example.com
# 可选：订阅路径前缀，默认空（即 https://sub.example.com/<subId>）；填 s 则为 https://sub.example.com/s/<subId>
CF_SUB_PREFIX=
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_API_TOKEN=your_cloudflare_kv_write_api_token
CF_KV_NAMESPACE_ID=your_kv_namespace_id

# ===== 本地校验与增量推送策略 =====
# 本地状态缓存文件路径
STATE_FILE=.sync_state.json
# 仅流量变动时，至少变化多少 MB 才触发推送（设为 0 表示只要有 1 字节变化就推送）
TRAFFIC_DIFF_THRESHOLD_MB=10
# 兜底强制刷新间隔（分钟）：即使流量变化小于阈值，超过该时间也会同步一次（设为 0 关闭）
MAX_STALE_MINUTES=60
# 当用户从 3x-ui 删除后，是否同步从 Cloudflare KV 删除对应 key
DELETE_REMOVED_FROM_KV=true
# 拉取订阅列表时的单个请求超时（秒）
REQUEST_TIMEOUT=15
